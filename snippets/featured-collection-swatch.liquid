{% comment %}
  Renders a list of product colour options in swatch styling

  Accepts:
  - product: {Object} Product Liquid object

  Usage:
  {% render 'featured-collection-swatch', product: product %}
{% endcomment %}
{% liquid
  assign colour_variant_exists = false
  for option in product.options
    if option == 'Color'
      assign colour_variant_exists = true
    endif
  endfor
%}

{% unless colour_variant_exists == false %}
  <div class="flex gap-2 mb-4">
    {% for variant in product.variants %}
      {% liquid
        assign swatch_lower = variant.title | downcase
        if swatch_lower == 'orange'
          assign swatch_color_class = 'bg-orange'
        elsif swatch_lower == 'green'
          assign swatch_color_class = 'bg-green'
        elsif swatch_lower == 'blue'
          assign swatch_color_class = 'bg-blue'
        elsif swatch_lower == 'pink'
          assign swatch_color_class = 'bg-pink'
        elsif swatch_lower == 'yellow'
          assign swatch_color_class = 'bg-yellow'
        elsif swatch_lower == 'navy'
          assign swatch_color_class = 'bg-navy'
        endif
      %}
      <span
        class="{% if forloop.index == 1 %}active-swatch-icon outline {%endif%}w-5 h-5 block rounded-full {{ swatch_color_class }} hover hover:outline outline-navy outline-offset-2 cursor-pointer"
        data-variant-id="{{ variant.id }}"
      ></span>
    {% endfor %}
  </div>
{% endunless %}

<script>
  {% for variant in product.variants %}
      variantData[{{ variant.id }}] = {
        secondary_image: "{{ variant.metafields.custom.secondary_image | image_url: width: 533 }}",
        featured_media: "{{ variant.featured_media | image_url: width: 533 }}",
        price: "{{ variant.price | money_with_currency }}",
        compare_at_price: "{{ variant.compare_at_price | money_with_currency }}",
        product_id: {{ variant.product.id }}
      }
  {% endfor %}

  function onVariantClick(e) {
    e.stopPropagation()
    e.preventDefault()

    let clickedVariantId = e.target.getAttribute('data-variant-id')
    let variant = variantData[clickedVariantId]

    let activeProduct = document.querySelector(`.active-swatch-icon`)

    if(activeProduct){
      activeProduct.classList.remove('active-swatch-icon')
      activeProduct.classList.remove('outline')
    }

    e.target.classList.add('active-swatch-icon')
    e.target.classList.add('outline')

    let productElement = document.querySelector(`[data-product-id="${variant.product_id}"]`)

    productElement.querySelector('.featured-image').src = variant.featured_media
    productElement.querySelector('.secondary-image').src = variant.secondary_image

    if(variant.compare_at_price) {
      productElement.querySelectorAll('.price-item--regular').forEach((element) => {element.innerHTML = variant.compare_at_price})
      productElement.querySelectorAll('.price-item--sale').forEach((element) => {element.innerHTML = variant.price})
    } else {
      productElement.querySelectorAll('.price-item--regular').forEach((element) => {element.innerHTML = variant.price})
    }
  }

  for (variantId in variantData) {
    const element = document.querySelector(`[data-variant-id="${variantId}"]`)
    element.addEventListener('click', onVariantClick)
  }
</script>
