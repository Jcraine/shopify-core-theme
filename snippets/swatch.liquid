{% comment %}
  Renders a swatch component.
  Accepts:
  - swatch: {Object} a swatch object
  - shape: {String} swatch shape. Accepts 'square', defaults to circle.

  Usage:
  {% render 'swatch',
    swatch: value.swatch
    shape: 'square'
  %}
{% endcomment %}

{%- liquid
  assign swatch_color_class = null
  assign swatch_lower = swatch | downcase
  if swatch_lower == "orange"
    assign swatch_color_class = "bg-orange"
  elsif swatch_lower == "green"
    assign swatch_color_class = "bg-green"
  elsif swatch_lower == "blue"
    assign swatch_color_class = "bg-blue"
  elsif swatch_lower == "pink"
    assign swatch_color_class = "bg-pink"
  elsif swatch_lower == "yellow"
    assign swatch_color_class = "bg-yellow"
  elsif swatch_lower == "navy"
    assign swatch_color_class = "bg-navy"
  endif
-%}

<span
  {% if swatch_color_class %}
    class="swatch{% if shape == 'square' %} swatch--square{% endif %}{% if swatch_color_class%} {{swatch_color_class}}{% endif %}"
  {% else %}
    class="swatch swatch--unavailable{% if shape == 'square' %} swatch--square{% endif %}"
  {% endif %}
>
</span>
